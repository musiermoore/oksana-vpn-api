APP_PORT=80

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=user
DB_PASSWORD=password
DB_DATABASE=database

GOOSE_DRIVER=mysql
GOOSE_DBSTRING="user:password@tcp(127.0.0.1:3306)/database?parseTime=true&multiStatements=true"
GOOSE_MIGRATION_DIR="./migrations"

TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEV_CHAT_ID=

# Telegram OIDC (credentials are issued by @BotFather > Login Widget)
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URI=https://api.oksana1984.ru/api/v1/auth/telegram/oidc/callback
# Comma-separated exact SPA URLs. Each URL is an approved post-login destination.
TELEGRAM_OIDC_FRONTEND_RETURN_URLS=https://public.oksana1984.ru/login
